# AI Service 配置（复制为 .env 并填入真实值；.env 已被 git 忽略）
AI_SERVICE_PORT=3100

# Chrome CDP 连接
CHROME_CDP_URL=http://127.0.0.1:9222

# AI 模型配置 (用于任务规划)
AI_API_KEY=
AI_BASE_URL=
AI_DEFAULT_MODEL=openai/gpt-4o

# Midscene 环境变量 (v1.3+ 配置方式)
OPENAI_API_KEY=
OPENAI_BASE_URL=
MIDSCENE_MODEL_NAME=Qwen/Qwen3-VL-235B-A22B-Instruct
MIDSCENE_MODEL_FAMILY=qwen3-vl
MIDSCENE_PREFERRED_LANGUAGE=Chinese

# 字节豆包模型（独立端点）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=

# LM Studio 本地模型（无需 API Key）
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
